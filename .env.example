# ==============================================================================
# PROJECT CONFIGURATION
# ==============================================================================
PROJECT_NAME="voyage-trip-agent"
ENVIRONMENT="development"               # development | staging | production
LOG_LEVEL="INFO"                        # DEBUG | INFO | WARNING | ERROR

# ==============================================================================
# LLM PROVIDERS (100% FREE & GENEROUS LIMITS)
# ==============================================================================
# 1. Primary LLM: Groq (https://console.groq.com - Free, ultra-fast, great tool-calling)
GROQ_API_KEY=your_groq_api_key_here
PRIMARY_MODEL="llama-3.3-70b-versatile"

# 2. Fallback LLM: Google Gemini (https://aistudio.google.com - 1500 free requests/day)
GEMINI_API_KEY=your_gemini_api_key_here
FALLBACK_MODEL="gemini-1.5-flash"

# 3. Optional: OpenRouter (https://openrouter.ai - Free tier models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# 4. Optional: OpenAI (Uncomment if you ever add paid credits later)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL="gpt-4o-mini"

# ==============================================================================
# LLMOPS / TRACING & EVALUATION (LangSmith)
# ==============================================================================
# Get free key from: https://smith.langchain.com
# Traces agent decisions, token usage, latency, and tool calls automatically
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT="voyage-trip-agent"

# ==============================================================================
# SEARCH & ATTRACTIONS (PLACES & ACTIVITIES)
# ==============================================================================
# Primary: Tavily AI Search (https://tavily.com - 1,000 free searches/month)
# Specially optimized for LLM agents and returns clean markdown
TAVILY_API_KEY=your_tavily_api_key_here

# Fallback: Serper Google Search (https://serper.dev - 2,500 free searches)
SERPER_API_KEY=your_serper_api_key_here

# ==============================================================================
# WEATHER SERVICES
# ==============================================================================
# Primary: OpenWeatherMap (https://openweathermap.org/api - Free tier)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Fallback: Open-Meteo (https://open-meteo.com)
# 100% FREE, NO API KEY NEEDED!
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"

# ==============================================================================
# CURRENCY EXCHANGE
# ==============================================================================
# Primary: ExchangeRate-API (https://www.exchangerate-api.com - 1,500 free requests/mo)
EXCHANGE_RATE_API_KEY=your_exchangerate_api_key_here

# Fallback: Frankfurter API (https://www.frankfurter.app)
# 100% FREE, NO API KEY NEEDED!
FRANKFURTER_BASE_URL="https://api.frankfurter.app"

# ==============================================================================
# HOTELS & ACCOMMODATION
# ==============================================================================
# RapidAPI Booking.com (https://rapidapi.com - Free tier available)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_BOOKING_HOST="booking-com.p.rapidapi.com"

# ==============================================================================
# FOOD & EVENTS
# ==============================================================================
# Optional: Food & Dining (https://docs.developer.yelp.com - 500 free requests/day)
# YELP_API_KEY=your_yelp_api_key_here

# Optional: Live Concerts & City Events (https://developer.ticketmaster.com - 5,000 free requests/day)
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here
